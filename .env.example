CRM_BASE_URL=https://novikov.envycrm.com/openapi/v1
CRM_API_KEY=
CRM_TYPE=envycrm
# Optional per-project override. Browser sends only project_id; these values remain server-side.
# PROJECT_PROJ_REAL_CRM_TYPE=envycrm
# PROJECT_PROJ_REAL_CRM_BASE_URL=https://example.envycrm.com/openapi/v1
# PROJECT_PROJ_REAL_CRM_API_KEY=
AI_BASE_URL=https://clodex.xyz/v1
AI_MODEL=gpt-6-sol
# Install local engine: python -m pip install faster-whisper
LOCAL_WHISPER_MODEL=base
# External provider must support whisper-1 and verbose_json with duration.
# Optional paid fallback, independent credentials; used only without faster-whisper.
# TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
AI_API_KEY=
AI_ALLOWED_HOSTS=clodex.xyz
PORT=8000
HOST=127.0.0.1
